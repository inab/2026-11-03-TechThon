# Copy to .env, then fill in NUXT_APP_SECRET:
#   cp local.env.example .env
#   sed -i "s|^NUXT_APP_SECRET=.*|NUXT_APP_SECRET=$(openssl rand -base64 32)|" .env
# What each variable means: Configuration table in docs/LOCAL.md.

# ==============================================================================
# Always needed
# ==============================================================================
NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://localhost:8080
NUXT_OAUTH_KEYCLOAK_REALM=workshop
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=nuxt-workshop
# DEV ONLY: this secret is in keycloak/realm-export.json
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=dev-only-secret-do-not-use-elsewhere
# At least 32 characters (see the sed line above)
NUXT_APP_SECRET=

# ==============================================================================
# Event day: the app under a participant's path,
# http://localhost:3000/annie/
# ==============================================================================
NUXT_PUBLIC_APP_URL=http://localhost:3000/annie/
NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=http://localhost:3000/annie/auth/keycloak
NUXT_APP_BASE_URL=/annie/
NUXT_SESSION_COOKIE_PATH=/annie/

# ==============================================================================
# Local: the app at the root, http://localhost:3000/
# ==============================================================================
# To use it, comment out the four Event day lines above, uncomment these four,
# and restart pnpm dev.
# NUXT_PUBLIC_APP_URL=http://localhost:3000
# NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=http://localhost:3000/auth/keycloak
# NUXT_APP_BASE_URL=/
# NUXT_SESSION_COOKIE_PATH=/
